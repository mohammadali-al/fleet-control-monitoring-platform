#!/usr/bin/env bash
# wf — the one workflow command. Thin at bootstrap; grows task by task.
# Implemented: new, lint, status, start.  Stubbed (supervisor does by hand for now):
# audit, check, run, review, merge, close, release, touches, sample.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TASKS="$ROOT/workflow/tasks"
GEN="$ROOT/workflow/generated"

die(){ echo "wf: $*" >&2; exit 1; }
taskdir(){ local id="$1"; local d; d=$(find "$TASKS" -maxdepth 1 -type d -name "${id}-*" | head -1); [ -n "$d" ] || die "no task $id"; echo "$d"; }
fm(){ sed -n '/^---$/,/^---$/p' "$1"; }                      # front-matter block
fmval(){ fm "$1" | grep -m1 "^$2:" | sed "s/^$2:[[:space:]]*//" || true; }

cmd_new(){
  local title="${1:?usage: wf new <title>}"
  local max=0 n
  for d in "$TASKS"/T-*; do [ -d "$d" ] || continue; n=$(basename "$d" | sed -E 's/^T-0*([0-9]+)-.*/\1/'); (( n>max )) && max=$n; done
  local id; id=$(printf 'T-%04d' $((max+1)))
  local dir="$TASKS/$id-$title"
  mkdir -p "$dir"
  sed -e "s/^id: T-XXXX/id: $id/" -e "s/^title: short-name/title: $title/" -e "s/^state: draft/state: draft/" \
      "$TASKS/_template/task.md" > "$dir/task.md"
  echo "created $dir/task.md"
}

cmd_lint(){
  local id="${1:?usage: wf lint <T-id>}"; local t; t="$(taskdir "$id")/task.md"; local ok=1
  for k in id title state touches tests after; do fm "$t" | grep -q "^$k:" || { echo "lint: missing front-matter '$k'"; ok=0; }; done
  for s in '## Why' '## What to build' '## Out of scope' '## Done means' '## Facts this brief relies on' '## Notes for the doer'; do
    grep -qF "$s" "$t" || { echo "lint: missing section '$s'"; ok=0; }; done
  if grep -IlP '[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}\x{2066}-\x{2069}\x{00AD}\x{FEFF}]' "$t" >/dev/null 2>&1; then
    echo "lint: raw bidi/invisible character in brief (R-02)"; ok=0; fi
  # facts: every file:line reference must point at an existing file
  { grep -oE '[A-Za-z0-9_./-]+\.(md|go|js|jsx|sh|ya?ml):[0-9]+' "$t" || true; } | sed 's/:.*//' | sort -u | while read -r f; do
    [ -e "$ROOT/$f" ] || echo "lint: fact references missing file: $f"; done
  [ "$ok" = 1 ] && echo "lint: $id OK" || { echo "lint: $id FAILED"; return 1; }
}

cmd_status(){
  local now="" next="" wait="" blocked="" closed=""
  for d in "$TASKS"/T-*; do [ -d "$d" ] || continue; local t="$d/task.md"; [ -f "$t" ] || continue
    local id ti st af; id=$(fmval "$t" id); ti=$(fmval "$t" title); st=$(fmval "$t" state); af=$(fmval "$t" after)
    local line="- **$id** $ti  \`after: $af\`"
    case "$st" in
      running|review) now+="$line (${st})"$'\n';;
      ready) next+="$line"$'\n';;
      merged) wait+="$line"$'\n';;
      blocked) blocked+="$line"$'\n';;
      closed) closed+="$line"$'\n';;
    esac
  done
  { echo "# STATUS — generated board"; echo
    echo "> Generated by \`wf status\`. **Do not edit by hand.** Last built: $(date +%F)"; echo
    echo "## Now (running / in review)"; echo "${now:-_none_}"
    echo "## Next (ready, in order)"; echo "${next:-_none_}"
    echo "## Waiting for the operator (merged → see CHECKS.md)"; echo "${wait:-_none_}"
    echo "## Blocked"; echo "${blocked:-_none_}"
    echo "## Recently closed (last 20)"; echo "${closed:-_none_}"
  } > "$GEN/STATUS.md"
  echo "wf: wrote $GEN/STATUS.md"
}

cmd_start(){
  local id="${1:?usage: wf start <T-id>}"; local d; d="$(taskdir "$id")"
  git -C "$ROOT" config core.hooksPath .githooks
  local br="task/$id"
  git -C "$ROOT" show-ref --verify --quiet "refs/heads/$br" && git -C "$ROOT" checkout "$br" || git -C "$ROOT" checkout -b "$br"
  echo "wf: on branch $br, hooks wired."
  echo "--- read: $d/task.md and workflow/rules/enforced.md ---"
  echo "after: $(fmval "$d/task.md" after)   touches: $(fmval "$d/task.md" touches)"
}

stub(){ echo "wf: '$1' is not implemented yet — the supervisor does this by hand (see ~/Desktop/workflow-proposal.md)."; }

case "${1:-}" in
  new) shift; cmd_new "$@";;
  lint) shift; cmd_lint "$@";;
  status) shift; cmd_status "$@";;
  start) shift; cmd_start "$@";;
  audit|check|run|review|merge|close|release|touches|sample) stub "$1";;
  ""|-h|--help|help) echo "usage: wf {new|lint|status|start|audit|check|run|review|merge|close|release|touches|sample}";;
  *) die "unknown command '$1'";;
esac
