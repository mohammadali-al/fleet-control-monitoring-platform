# One-shot run by fleet-agent-liveness.timer every 45 s (T-0027). It (1) starts
# fleet-agent.service if it is not active, and (2) restarts it if its heartbeat
# file is older than the pushed heartbeat_threshold, i.e. the agent is hung
# (deadlocked yet still "active"). Both are logged. The ExecStart line is
# generated by watchdog.LivenessExecStart (onboarding installs the same text); a
# test keeps this file in step with it. Do not edit by hand.
[Unit]
Description=Fleet agent liveness check

[Service]
Type=oneshot
User=root
ExecStart=/bin/sh -c 'u=fleet-agent.service; f=/var/lib/fleet-agent/watchdog/heartbeat-agent; d=90; now=$$(date +%%s); if ! systemctl is-active --quiet "$$u"; then logger -t fleet-liveness "$$u was not active; starting it"; systemctl start "$$u"; exit 0; fi; [ -r "$$f" ] || exit 0; read -r ts th <"$$f"; case "$$ts" in ""|*[!0-9]*) ts=0;; esac; case "$$th" in ""|*[!0-9]*) th=$$d;; esac; s=$$(systemctl show -p ActiveEnterTimestamp --value "$$u" 2>/dev/null); if [ -n "$$s" ]; then s=$$(date -d "$$s" +%%s 2>/dev/null) || s=0; else s=0; fi; ref=$$ts; [ "$$s" -gt "$$ref" ] && ref=$$s; [ "$$ref" -gt 0 ] || exit 0; if [ $$((now-ref)) -gt "$$th" ]; then logger -t fleet-liveness "$$u heartbeat stale (hung); restarting it"; systemctl restart "$$u"; fi'
