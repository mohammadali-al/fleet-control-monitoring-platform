diff --git a/internal/exec/session_linux.go b/internal/exec/session_linux.go
new file mode 100644
index 0000000..54df361
--- /dev/null
+++ b/internal/exec/session_linux.go
@@ -0,0 +1,11 @@
+//go:build linux
+
+package exec
+
+import "syscall"
+
+// attach makes attrs place the child in this cgroup.
+func (c *Cgroup) attach(attrs *syscall.SysProcAttr) {
+	attrs.UseCgroupFD = true
+	attrs.CgroupFD = int(c.dir.Fd())
+}
