diff --git a/deploy/systemd/fleet-watchdog-liveness.timer b/deploy/systemd/fleet-watchdog-liveness.timer
index 9760f19..d44045c 100644
--- a/deploy/systemd/fleet-watchdog-liveness.timer
+++ b/deploy/systemd/fleet-watchdog-liveness.timer
@@ -1,13 +1,15 @@
-# Independent 1-minute liveness check for fleet-watchdog.service (architecture
-# 11.7, layer 2): runs fleet-watchdog-liveness.service, a one-shot that starts
-# the watchdog if its unit is not active. Zero steady-state cost. Enable both the
-# timer and fleet-watchdog.service at boot so the watchdog returns after a reboot.
+# Independent 45-second liveness check for fleet-watchdog.service (architecture
+# 11.7, layer 2; cadence fixed since T-0027, it is not a policy setting): runs
+# fleet-watchdog-liveness.service, a one-shot that starts the watchdog if its unit
+# is not active and restarts it if its heartbeat is stale (hung). Zero
+# steady-state cost. Enable both the timer and fleet-watchdog.service at boot so
+# the watchdog returns after a reboot.
 [Unit]
-Description=Fleet watchdog liveness check (every minute)
+Description=Fleet watchdog liveness check (every 45 s)
 
 [Timer]
 OnBootSec=1min
-OnUnitActiveSec=1min
+OnUnitActiveSec=45s
 AccuracySec=5s
 Unit=fleet-watchdog-liveness.service
 
