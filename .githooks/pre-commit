#!/usr/bin/env bash
# pre-commit — active guards (R-02 bidi, R-03 generated). Others planned (see enforced.md).
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACM)"
[ -z "$staged" ] && exit 0
fail=0

# R-02: no raw bidi/invisible characters in staged text files.
while IFS= read -r f; do
  [ -f "$root/$f" ] || continue
  if LC_ALL=C.UTF-8 grep -IlP '[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}\x{2066}-\x{2069}\x{00AD}\x{FEFF}]' "$root/$f" >/dev/null 2>&1; then
    echo "pre-commit: bidi/invisible character in $f (R-02). Write it as an escape." >&2; fail=1
  fi
done <<< "$staged"

# R-03: workflow/generated/** is written only by wf (set WF_GENERATED_OK=1 to allow).
if [ "${WF_GENERATED_OK:-0}" != "1" ]; then
  if echo "$staged" | grep -q '^workflow/generated/'; then
    echo "pre-commit: workflow/generated/** is generated; run 'wf status' and commit with WF_GENERATED_OK=1 (R-03)." >&2; fail=1
  fi
fi

[ "$fail" = 0 ] || { echo "pre-commit: refused. A refusal means stop." >&2; exit 1; }
exit 0
